<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 코스 공유와 파티. 서버 주소가 없는 빌드에서는 요청을 보내지 않는다. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 차에 연결된 음악 앱을 찾는다. -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:name=".service.DriveApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="에움길"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <service
            android:name=".service.DriveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="코스 주행 중 내비 구간 교체와 음성 안내" />
        </service>

        <!-- Gleo 음성 연동(설계 2026-11-13). Gleo AI 가 setPackage 로 보내는 함수 세 개를 받는다. -->
        <!-- 출발은 schema 에서 activity 다. 투명한 화면이 잠깐 떠 있는 동안 출발하고 바로 닫힌다(설계 3-2, 11-14).
             에움길 창과 다른 작업으로 떠서 창 배치를 바꾸지 않는다. 주행 중 음성 출발이 되도록 주행 중 허용 화면이다. -->
        <activity
            android:name=".service.GleoStartActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="START_DRIVING_COURSE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <receiver
            android:name=".service.GleoReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="FIND_DRIVING_COURSES" />
                <action android:name="START_DRIVING_COURSE" />
                <action android:name="CONTROL_BYWAY_DRIVE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
